    Damping = BeckeJohnson {
      a1 = 0.841
      a2 = 3.834
    }
    s6 = 1.0
    s8 = 0.0
    cutoff = 94.868329805051374
    cutoffcn = 40.000000000000000
    threebody = No
    hhrepulsion = No
  }
