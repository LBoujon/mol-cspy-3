Geometry = GenFormat {
    <<< geometry.gen
}
Driver = GeometryOptimization {
    Optimizer = LBFGS{}
    MovedAtoms = 1:-1
    Convergence = {GradElem = 0.00058}
    MaxSteps = 2500
    OutputPrefix = geom.out
    LatticeOpt = Yes
}
Hamiltonian = DFTB {
    Scc = Yes
    SlaterKosterFiles = Type2FileNames {
        Prefix = ../../parameter_sets/3ob-3-1/
        Separator = "-"
        Suffix = ".skf"
    }

    ThirdOrderFull = yes
    SCCTolerance = 1e-05
    MaxSCCIterations = 100
    HCorrection = Damping{
        Exponent = 4.0
    }

    Dispersion = DftD3 {
        Damping = BeckeJohnson {
            a1 = 0.841
            a2 = 3.834
        }
        s6 = 1.0
        s8 = 0.0
    }

    KPointsAndWeights = SupercellFolding {                           
               2 0 0                              
               0 5 0
               0 0 4
               0.5 0 0.5                            
           } 

    MaxAngularMomentum {
         O = p
         H = s
         C = p
     }
    HubbardDerivs {
        O = -0.1575
        H = -0.1857
        C = -0.1492
    }
}
